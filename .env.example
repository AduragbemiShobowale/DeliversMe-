# Copy to .env.local and fill in values from Supabase → Project Settings → API.
# ONLY the public (anon / publishable) key belongs here. NEVER put the service_role key in a VITE_ variable:
# every VITE_ variable is bundled into the browser JavaScript.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Public site settings (optional)
VITE_SITE_URL=http://localhost:5173
VITE_SUPPORT_PHONE=+234 800 000 0000
VITE_SUPPORT_EMAIL=support@example.com
# Social links are hidden unless set
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_X=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_LINKEDIN=
